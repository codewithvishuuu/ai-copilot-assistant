# =============================================================
# Community Copilot — example environment file.
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file (it is gitignored).
# NEVER paste your bot token into chat, docs, or source code.
# =============================================================

# ----- Discord -----
# 1. Create an application at https://discord.com/developers/applications
# 2. Add a Bot, then copy its token into `.env` as DISCORD_TOKEN.
# 3. Invite the bot to your test server with the "applications.commands" scope
#    and only the permissions listed in README.md (no Administrator).
DISCORD_TOKEN=

# Comma-separated Discord guild (server) IDs allowed to use the bot.
# Empty = the bot refuses to operate in any guild (safe default).
# Example: GUILD_ALLOWLIST=111111111111111111,222222222222222222
GUILD_ALLOWLIST=

# Optional: restrict usage to these channel / forum / thread IDs.
# Empty = every channel inside an allowed guild.
# Example: CHANNEL_ALLOWLIST=333333333333333333
CHANNEL_ALLOWLIST=

# Optional but recommended while developing: sync slash commands to this
# guild instantly instead of waiting for Discord's global sync.
# Example: TEST_GUILD_ID=111111111111111111
TEST_GUILD_ID=

# Optional: role IDs treated as moderators (in addition to Discord's
# "Manage Threads" / "Manage Messages" permissions).
MODERATOR_ROLE_IDS=

# Optional: user IDs allowed to use developer-only commands (/debug).
DEV_USER_IDS=

# ----- Ollama (local model server) -----
# Install Ollama, then run:  ollama pull gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Context window (RAM-sensitive on small machines; 4096 is a safe start).
OLLAMA_NUM_CTX=4096

# Seconds to wait for a single model call.
OLLAMA_REQUEST_TIMEOUT_S=180

# How long the model stays in RAM after a request (Ollama keep_alive).
# For a demo day, raise this (e.g. 6h) so the ~34 s cold load is paid once.
OLLAMA_KEEP_ALIVE=5m

# Hard cap on tokens generated per model call. Bounds CPU time per request;
# raise it if summaries get cut off, lower it on very slow machines.
OLLAMA_MAX_TOKENS=1024

# Maximum simultaneous Ollama generation calls across the whole bot.
# Default 2 = one /summarize job and one chat reply may overlap (as before);
# set 1 on very small machines to serialize everything (a chat reply then
# waits behind a running job, bounded by JOB_TIMEOUT_S).
OLLAMA_MAX_CONCURRENT=2

# Sampling temperature. Lower = more deterministic extraction.
MODEL_TEMPERATURE=0.3

# Gemma 4 "thinking" mode. Off = faster, more predictable JSON output.
THINKING_ENABLED=false

# Allow image analysis when the selected model supports vision.
# The bot still verifies the capability at runtime; this is a master switch.
VISION_ENABLED=true

# ----- Thread collection limits -----
MAX_MESSAGES=150
HARD_MAX_MESSAGES=500
MAX_CHARS=24000
MAX_IMAGES=4
MAX_IMAGE_BYTES=6000000

# ----- Queue and rate limits -----
QUEUE_CAPACITY=5
PER_USER_COOLDOWN_S=60
PER_GUILD_HOURLY_LIMIT=20
JOB_TIMEOUT_S=300
FETCH_TIMEOUT_S=60

# ----- Conversation (mention-triggered chat) -----
# The bot replies when @mentioned. The privileged Message Content intent stays
# off: Discord only exposes a message's text when the bot is mentioned.
# Chat turns persist across restarts in the local database, scoped strictly per
# (guild, channel, user); the invoker can delete their own history in a channel
# with /clear-conversation.
CONVERSATION_ENABLED=true

# Exchanges loaded into one chat prompt, the prompt character budget, and the
# inactivity TTL of the in-process fallback context (used only while the
# database is unavailable).
CONVERSATION_MAX_TURNS=6
CONVERSATION_MAX_CHARS=6000
CONVERSATION_TTL_S=3600

# Storage bounds for persisted turns: age after which the daily sweep deletes
# them, and the hard per-(guild, channel, user) row cap enforced on every write
# (must be >= 2 x CONVERSATION_MAX_TURNS).
CONVERSATION_RETENTION_DAYS=7
CONVERSATION_MAX_STORED_TURNS=40

# Per-user cooldown between model-backed replies, and per-reply caps.
CONVERSATION_COOLDOWN_S=10
CONVERSATION_TIMEOUT_S=120
CONVERSATION_MAX_TOKENS=512

# How many chat requests may WAIT for the single in-flight chat generation.
# Beyond this, the requester gets one rate-limited "busy" notice instead of
# piling up waiting tasks. 0 = when busy, answer immediately without waiting.
CONVERSATION_MAX_WAITING=2

# ----- Conversation KB grounding (Phase 4, D22 — implemented) -----
# Optional knowledge-base context for @mention chat: a bounded block built ONLY
# from moderator-approved documents (approved solutions + thread fingerprints).
# Retrieved text is treated as untrusted data (fenced; instructions inside are
# never followed). If the chat prompt budget is tight, the WHOLE block is
# dropped before any conversation history is removed — continuity outranks
# retrieval. Disabled/empty/failing retrieval keeps chat unchanged.
CONVERSATION_GROUNDING_ENABLED=true

# Most documents considered per chat prompt (1-5).
CONVERSATION_GROUNDING_TOP_K=2

# Character cap for the whole KB block, fence and headers included (200-4000).
CONVERSATION_GROUNDING_MAX_CHARS=1200

# ----- Content Studio (Phase 2B) -----
# Draft generation is bounded. A draft is never published by generation: a
# moderator must submit it, a different moderator must approve the exact target
# and version, and then a moderator must run /content-publish. Publishing is
# OFF by default; enable only after the bot can post in the intended channel.
CONTENT_PUBLISHING_ENABLED=false
CONTENT_GENERATION_MAX_CHARS=1800
CONTENT_GENERATION_TIMEOUT_S=120
CONTENT_GENERATION_MAX_TOKENS=1024
CONTENT_APPROVAL_TTL_S=3600
CONTENT_CONTEXT_MAX_CHARS=2000
CONTENT_CONTEXT_TOP_K=3

# ----- Storage and privacy -----
DATA_DIR=data
DB_FILENAME=copilot.db
RETENTION_DAYS=90
LOG_LEVEL=INFO

# Set true only for local debugging: logs message content (privacy risk).
DEBUG_LOG_CONTENT=false

# Controls the /summarize reply visibility:
#   true  = only the requester sees the reply (default)
#   false = the whole channel sees the reply (presentation use)
# All OTHER commands are ALWAYS private regardless of this setting.
# Note: hiding the reply does NOT hide the underlying thread
# from the bot. See SECURITY.md.
EPHEMERAL_BY_DEFAULT=true

# ----- Community insights -----
INSIGHTS_MIN_THREADS=5
INSIGHTS_WINDOW_DAYS=30
